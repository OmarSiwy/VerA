// Exclusion takes precedence over membership in an inclusion set.
//! lrm 3.4.2
//! reject E0361
module string_range_excluded_target(p);
    inout p;
    electrical p;
    parameter string kind = "NPN" from '{"NPN", "PNP"} exclude '{"PNP"};
    analog I(p) <+ 0.0;
endmodule
module ch03_string_range_excluded_rejected(p);
    inout p;
    electrical p;
    string_range_excluded_target #(.kind("PNP")) u(p);
endmodule
