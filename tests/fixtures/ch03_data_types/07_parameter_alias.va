// §3.4.7 parameter aliases — the LRM's own `nmos2` example. An `aliasparam` is
// a second NAME for one parameter, not a second parameter, and the only thing
// the alias exists to do is carry an OVERRIDE:
//
//     nmos2 #(.trise(5)) m1(...);
//     nmos2 #(.dtemp(5)) m2(...);
//     "and the value of the parameter dtemp, as used in the module equations
//      for both instances, is 5."
//
// So the override below names the ALIAS and the equations read the ORIGINAL,
// which is the one arrangement in which the alias table is load-bearing. This
// file used to override `dtemp` — the original name — so it stayed green with
// the `aliasparam` line deleted, and it also read `trise` inside the analog
// block, which §3.4.7 forbids outright: "the alias_identifier shall not occur
// anywhere else in the module ... the equations in the module shall reference
// the parameter by its original name, not the alias."
//
//! param trise = 25
//! lrm 3.4.7
`include "check.vh"
module ch03_parameter_alias(p, n);
    inout p, n;
    electrical p, n;
    parameter real dtemp = 0 from [-273.15:inf);
    aliasparam trise = dtemp;

    analog begin
        `CHECKX("an override through the alias reaches the original parameter", dtemp, 25.0);
        I(p, n) <+ dtemp + V(p, n);
    end
endmodule
