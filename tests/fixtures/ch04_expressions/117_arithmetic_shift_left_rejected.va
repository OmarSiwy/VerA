// LRM 4.2.11 bans BOTH arithmetic shift operators from an analog block: "the
// arithmetic shift operators, <<< and >>>. The arithmetic shift operators can
// not be used in an analog block."
//
// 05_bitwise_shift.va pins `>>>`. This is `<<<`, so a compiler that only
// filtered the right-shift spelling is caught. The two are separate tokens in
// the grammar, and a hand-written lexer that special-cases one can easily miss
// the other.
//
//! lrm 4.2.11
//! reject E0324
module ch04_arithmetic_shift_left_rejected(p, n);
    inout p, n;
    electrical p, n;
    integer a, value;

    analog begin
        a = 5;
        value = a <<< 1;
        I(p, n) <+ value;
    end
endmodule
