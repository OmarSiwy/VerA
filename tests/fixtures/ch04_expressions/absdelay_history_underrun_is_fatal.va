//! analysis tran
//! print none
`include "check.vh"
module absdelay_history_underrun_is_fatal(p, n);
  inout p, n; electrical p, n;
  analog begin
    `CHECK("Input(0) while t < td", absdelay($abstime * 1e9, 1026n), 0.0, 1e-9);
    I(p, n) <+ 0.0;
  end
endmodule
