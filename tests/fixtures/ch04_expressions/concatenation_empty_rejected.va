// §4.2.13: "A concatenation is the result of the joining together of bits
// resulting from one or more expressions into a single value." A.8.1 says the
// same in grammar:
//
//     analog_concatenation ::= { analog_expression { , analog_expression } }
//
// One or more. `{}` below has none, so it has no width and no value. The legal
// concatenations are 30_concatenation.va.
//
//! lrm 4.2.13
//! lrm A.8.1
//! reject E0326
`include "disciplines.vams"
module ch04_concatenation_empty(p, n);
  inout p, n; electrical p, n;
  integer k;
  analog begin
    k = {};
    I(p, n) <+ k * V(p, n);
  end
endmodule
