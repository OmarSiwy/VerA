//! analysis tran
//! print none
`include "check.vh"
module absdelay_maxdelay_sizes_history(p, n);
  inout p, n; electrical p, n;
  analog begin
    `CHECK("a 1500-sample lookback within maxdelay is the delay",
           absdelay($abstime * 1e12, 1.5n, 1.5n) - max($abstime * 1e12 - 1500.0, 0.0), 0.0, 1e-6);
    I(p, n) <+ 0.0;
  end
endmodule
