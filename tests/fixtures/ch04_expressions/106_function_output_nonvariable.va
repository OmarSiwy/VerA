// LRM 4.7.2: the actual for an output formal must be a variable; V(p) is not
// an lvalue.
//! reject E0316
module ch4_fn_out_actual(p); inout p; electrical p; real dummy; analog function real f; input x; output y; real x,y; begin y=x; f=x; end endfunction analog begin dummy=f(V(p),V(p)); I(p)<+dummy; end endmodule
