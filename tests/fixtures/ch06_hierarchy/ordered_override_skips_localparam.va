// §3.4.5: "Local parameters are identical to parameters except that they cannot
// directly be modified by the defparam statement or by the ordered or named
// parameter value assignment." §6.3 then gives the ordered assignment its order —
// "in the order of their declaration" — and the two sentences compose: the order
// is over the parameters an assignment CAN modify, so an ordered value steps
// PAST a localparam declared between two parameters instead of landing on it.
//
// The child declares `g1`, then a localparam `lp = 2.0 * g1`, then `g2`, and the
// instance writes `#(10.0, 100.0)`. The conforming binding is g1 = 10.0 and
// g2 = 100.0, with lp following its expression to 20.0. A compiler that walks
// the FULL declaration list positionally instead — the bug this file pins —
// forces lp to 100.0 (overriding what §3.4.5 says cannot be overridden), leaves
// g2 at its default 1.0, and reads the sum as 111.0 instead of 130.0.
//
// Every addend is asserted separately as well as the sum, so the transcript
// names WHICH binding slipped: g1 discriminates a compiler that refused the
// whole list, lp one that overrode the localparam, g2 one that dropped the
// value the localparam absorbed. The defaults (1.0 each) are deliberately
// unequal to every override so no wrong path lands on a right number.
//
// With V(p,n) = 0.5 the module stamps 130.0 * 0.5 = 65.0.
//
//! lrm 3.4.5
//! lrm 6.3
//! bias V(p) = 0.75, V(n) = 0.25
`include "check.vh"
module ch6_olp_parent(p, n);
  inout p, n; electrical p, n;
  ch6_olp_kid #(10.0, 100.0) u(p, n);
endmodule

module ch6_olp_kid(a, b);
  inout a, b; electrical a, b;
  parameter real g1 = 1.0;
  localparam real lp = 2.0 * g1;
  parameter real g2 = 1.0;
  analog begin
    `CHECKX("the first ordered value lands on the first parameter", g1, 10.0);
    `CHECKX("the localparam keeps its own expression over the overridden g1", lp, 20.0);
    `CHECKX("the second ordered value skips the localparam and lands on g2", g2, 100.0);
    `CHECKX("so the §3.4.5-conforming sum is 10 + 20 + 100", g1 + lp + g2, 130.0);
    I(a, b) <+ (g1 + lp + g2) * V(a, b);
  end
endmodule
