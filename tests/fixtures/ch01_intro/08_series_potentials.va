// §1.3.2 KPL: the algebraic sum of branch potentials around a loop is zero, so
// two series branch potentials telescope into the end-to-end one. At V(p)=1.0,
// V(mid)=0.25, V(n)=-0.5 that is 0.75 + 0.75 = 1.5, which is also V(p) - V(n).
//
// The biases are dyadic on purpose, so the exactness claim is true and not merely
// lucky: 1.0, 0.25 and 0.5 are each representable, 1.0-0.25 == 0.75 and
// 0.25-(-0.5) == 0.75 exactly, and 0.75+0.75 == 1.5 exactly, so the tolerance is
// doing no work. The previous V(mid)=0.3 produced the same two 1.5s with residual
// 0.0, but neither of ITS subtractions was exact — double(1.0)-double(0.3) is not
// representable and rounds to double(0.7) — so the comment justifying the wants
// was false about the arithmetic it justified.
//
//! lrm 1.3.2
//! bias V(p) = 1.0, V(mid) = 0.25, V(n) = -0.5
`include "check.vh"
module ch01_series_potentials(p, mid, n);
    inout p, mid, n;
    electrical p, mid, n;
    analog begin
        `CHECK("series branch potentials", V(p, mid) + V(mid, n), 1.5, 1e-15);
        `CHECK("end-to-end potential", V(p, n), 1.5, 1e-15);
        V(p, mid) <+ 1.0;
        V(mid, n) <+ 2.0;
    end
endmodule
