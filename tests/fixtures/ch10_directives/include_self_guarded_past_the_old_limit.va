`ifndef DONE
`include "include_self_guarded_past_the_old_limit.va"
`else
`ifndef EMITTED
`define EMITTED
`include "check.vh"
module include_self_guarded_past_the_old_limit(p);
  inout p; electrical p;
  integer depth;
  analog begin
    depth = `DEPTH;
    `CHECKI("nested include opens", depth, 40);
    I(p) <+ V(p);
  end
endmodule
`endif
`endif
