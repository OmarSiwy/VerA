// LRM 4.4: a net may only be read through an access function; the rejection
// lands at the ACCESS, which is the more useful diagnostic.
//! reject E0315
// A scalar discrete bit is promoted to an analog integer; this snapshots current lowering.
module ch7_discrete_scalar_bit(p, d);
  inout p; electrical p; input d; wire d;
  analog I(p) <+ d;
endmodule
