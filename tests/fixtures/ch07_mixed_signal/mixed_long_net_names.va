// §7.2 lets an analog block read a digital net, and §2.8 lets its name run
// to at least 1024 characters. The mixed-signal testbench names each digital
// value the analog half reads beside its device field, and composed those
// names, and the module's, in 256-byte buffers: a 300-character net failed
// the build as "out of memory". They are now sized for the longest name a
// model can declare.
//
// HAND DERIVATION. As m02_01_dc_time_zero_settle.va: axx... is 1, so
// bxx... = ~1 = 0 and cxx... = ~0 = 1 after the time-zero settle;
// the two checks read 1.0 and 0.0.
//
//! lrm 2.8
//! lrm 8.4.2
//! analysis dc
`timescale 1ns/1ns
`include "check.vh"
module mxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx(vo);
  inout vo; electrical vo;
  reg  ;
  wire , ;
  initial  = 1'b1;
  assign  = ~;
  assign  = ~;
  analog begin
    `CHECKX("a 300-character digital net reaches the analog block",  ? 1.0 : 0.0, 1.0);
    `CHECKX("and so does its neighbour",  ? 1.0 : 0.0, 0.0);
    V(vo) <+  ? 1.0 : 0.0;
  end
endmodule
