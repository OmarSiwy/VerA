// §7.3.1 and specification/Vague_Decisions.md VD-113: a `reg` the analog
// context assigns holds every bit IEEE 1364-2005 gives it, and the analog
// context computes the right-hand side of the assignment as IEEE 1364
// sizes it (§5.4.1, §5.5.1-§5.5.3, Table 5-22), so for the same statement
// over the same operand values it computes the bits the digital engine
// computes. That identity is what this fixture asserts; no digits are
// written because the reference is the digital engine's own evaluation.
//
// THE DESIGN. A mixed module (its `initial` block waits). The digital
// process computes d1..d8 from x and y2 (65600-bit `reg`s it owns) and
// nothing else; the analog block computes a1..a8 from the same
// statements. The analog side reads every digital `reg` through its
// `Model` words. Each statement's check is three: every bit equal (a wide
// `==`, itself a 1-bit result in a 65600-bit context), bits 30..0, and the top
// 31 bits. The table covers the operators whose limb algorithms differ:
//   d1 = x + y2  (+)
//   d2 = y2 - x  (- wrapping below zero)
//   d3 = x * y2  (* cut to the width)
//   d4 = x / y2  (/ unsigned)
//   d5 = x % y2  (% unsigned)
//   d6 = x << 1000  (<<)
//   d7 = x >> 999  (>>)
//   d8 = (x < y2) + (x > y2) * 2 + (x == x) * 4  (comparisons)
// Two time points (0 and 1n), three checks per statement: checks 48.
// 65600 bits is past `wide_kernels.zw_native_max` (128): the analog side
// computes on 32-bit limbs.
// 65600 bits is past Zig's widest integer (u65535) and the IEEE 1364-2005
// §4.3.1 minimum (2^16 bits) every implementation must allow.
//
//! lrm 7.3.1
//! inherited IEEE 1364-2005 5.4.1
//! inherited IEEE 1364-2005 5.5.2
//! analysis tran
//! time 0, 1n
//! checks 48
`timescale 1ns/1ns
`include "check.vh"
module ch7_wide_reg_matches_digital_65600(p);
  inout p; electrical p;
  parameter integer K = -5;
  parameter real R = 2.5;
  reg [65599:0] x, y2;
  reg [65599:0] d1, d2, d3, d4, d5, d6, d7, d8;
  reg [65599:0] a1, a2, a3, a4, a5, a6, a7, a8;
  reg [39:0] eq;
  initial begin
    x = 65600';
    y2 = 65600';
    d1 = x + y2;
    d2 = y2 - x;
    d3 = x * y2;
    d4 = x / y2;
    d5 = x % y2;
    d6 = x << 1000;
    d7 = x >> 999;
    d8 = (x < y2) + (x > y2) * 2 + (x == x) * 4;
    #1 x = x;
  end
  analog begin
    a1 = x + y2;
    eq = a1 == d1;
    `CHECKI("d1 every bit", eq[0], 1);
    `CHECKEQ("d1 bits 30..0", a1[30:0], d1[30:0], 0);
    `CHECKEQ("d1 top 31 bits", a1[65599:65569], d1[65599:65569], 0);
    a2 = y2 - x;
    eq = a2 == d2;
    `CHECKI("d2 every bit", eq[0], 1);
    `CHECKEQ("d2 bits 30..0", a2[30:0], d2[30:0], 0);
    `CHECKEQ("d2 top 31 bits", a2[65599:65569], d2[65599:65569], 0);
    a3 = x * y2;
    eq = a3 == d3;
    `CHECKI("d3 every bit", eq[0], 1);
    `CHECKEQ("d3 bits 30..0", a3[30:0], d3[30:0], 0);
    `CHECKEQ("d3 top 31 bits", a3[65599:65569], d3[65599:65569], 0);
    a4 = x / y2;
    eq = a4 == d4;
    `CHECKI("d4 every bit", eq[0], 1);
    `CHECKEQ("d4 bits 30..0", a4[30:0], d4[30:0], 0);
    `CHECKEQ("d4 top 31 bits", a4[65599:65569], d4[65599:65569], 0);
    a5 = x % y2;
    eq = a5 == d5;
    `CHECKI("d5 every bit", eq[0], 1);
    `CHECKEQ("d5 bits 30..0", a5[30:0], d5[30:0], 0);
    `CHECKEQ("d5 top 31 bits", a5[65599:65569], d5[65599:65569], 0);
    a6 = x << 1000;
    eq = a6 == d6;
    `CHECKI("d6 every bit", eq[0], 1);
    `CHECKEQ("d6 bits 30..0", a6[30:0], d6[30:0], 0);
    `CHECKEQ("d6 top 31 bits", a6[65599:65569], d6[65599:65569], 0);
    a7 = x >> 999;
    eq = a7 == d7;
    `CHECKI("d7 every bit", eq[0], 1);
    `CHECKEQ("d7 bits 30..0", a7[30:0], d7[30:0], 0);
    `CHECKEQ("d7 top 31 bits", a7[65599:65569], d7[65599:65569], 0);
    a8 = (x < y2) + (x > y2) * 2 + (x == x) * 4;
    eq = a8 == d8;
    `CHECKI("d8 every bit", eq[0], 1);
    `CHECKEQ("d8 bits 30..0", a8[30:0], d8[30:0], 0);
    `CHECKEQ("d8 top 31 bits", a8[65599:65569], d8[65599:65569], 0);
    I(p) <+ V(p);
  end
endmodule
