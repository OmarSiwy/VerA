// §9.5.3 $swrite/$sformat are the display tasks writing into a string variable
// instead of the transcript — "the first argument to $swrite shall be a string
// variable to which the resulting string shall be written, instead of a variable
// specifying the file to which to write" — so §9.4.3 governs the text they
// produce: Table 9-23 gives %e "Display 'real' in an exponential format" with
// "the full formatting capabilities available in the C language", and its own
// example reads "the format specification %10.3g sets a minimum field width of
// 10 with three (3) fractional digits".
//
// The formatted text is not a number, so the only way to pin it with a value is
// to send it back the way it came, through §9.5.4.2 $sscanf. The bias makes
// V(p,n) = 0.5, so "%10.4e" of it is "5.0000e-01" — exactly ten characters, so
// the width-10 MINIMUM is already met and no padding is added — and scanning
// that back with %e must recover 0.5 exactly, since 5.0000e-01 is 1/2 with no
// digits lost. $sscanf also "returns the number of items read", one here.
//
// A formatter that dropped the field width, the four fractional digits or the
// exponent would still round-trip; what this catches is text that is not the
// number at all, which is what a no-op $sformat leaves behind.
//
//! bias V(p) = 0.5
//! print none
//! lrm 9.4.3
//! lrm 9.5.3
//! lrm 9.5.4.2
`include "check.vh"
module ch09_string_formatting(p, n);
  inout p, n; electrical p, n;
  string text;
  real back;
  integer nread;
  analog begin
    $swrite(text, "value=%g", V(p,n));
    $sformat(text, "value=%10.4e", V(p,n));
    nread = $sscanf(text, "value=%e", back);
    `CHECKI("$sscanf read one item back out of the formatted string", nread, 1);
    `CHECKX("%10.4e of 0.5 round-trips to 0.5", back, 0.5);
    I(p,n) <+ V(p,n);
  end
endmodule
