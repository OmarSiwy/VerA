// §9.5.1: "If a file cannot be opened (either the file does not exist and the
// type specified is r ... ), a zero is returned for the mcd or fd."
// "ch09_047_missing.dat" is a name no fixture in this directory ever creates,
// so it does not exist beside the testbench and this open MUST yield 0.
//
// §9.5.4.2 then fixes the scan: "The number of successfully matched and
// assigned input items is returned in code; this number can be 0 in the event
// of an early matching failure... If the input ends before the first matching
// failure or conversion, EOF is returned."
//
// Both halves of that are here, and the SECOND one is what makes the fixture
// bite. On the missing file there is no input at all, so code is 0 or EOF —
// never the 1 a satisfied %d would report — and that half is written `code <= 0`
// because the LRM leaves EOF's numeric value to IEEE 1364. That check alone is
// satisfied by an implementation that answers 0 to everything, which is why the
// fixture also writes a file containing "42\n" and scans it: one item matched
// and assigned, so code is 1 and value is 42. Those two digits separate a real
// $fscanf from a constant, and `code <= 0` on its own cannot.
//
// WHEN THE FILE IS WRITTEN, AND WHEN IT IS READ. §9.5.9: "If a file is being
// written to during an iterative solve, then the file write operations shall
// not be performed unless the iteration is accepted." So "42\n" is written by
// `@(initial_step)` inside the t = 0 solve and reaches the file only when that
// point is accepted; the read happens at t = 1e-3, the next point, where the
// file holds exactly "42\n" whichever way a tool orders the "w" open's
// truncation against acceptance. The missing-file half is asserted at both
// points (2 + 2), the read-back half at t = 1e-3 only (2): six checks.
// (Reconciler, 2026-10-08: an earlier revision wrote, closed, reopened and
// scanned in ONE evaluation and asserted 1/42 there. That read cannot see a
// write §9.5.9 holds back until the iteration it is in is accepted.)
//
// The filenames are unique to this fixture on purpose: nine §9.5 fixtures used
// to share "fixture.dat" and one of them created it, which silently retired the
// missing-file rule from the second run onward.
//
//! lrm 9.5.1
//! lrm 9.5.4.2
//! lrm 9.5.4
//! lrm 9.5.9
//! time 0, 1e-3
//! checks 6
`include "check.vh"
module ch09_atomic_fscanf(p, n);
  inout p, n; electrical p, n;
  integer fd, code, value, good_fd, good_code, good_value;
  analog begin
    fd = $fopen("ch09_047_missing.dat", "r");
    code = $fscanf(fd, "%d", value);
    @(initial_step) begin
      good_fd = $fopen("ch09_047_fscanf.dat", "w");
      $fwrite(good_fd, "42\n");
      $fclose(good_fd);
    end
    `CHECKI("open r of a missing file returns 0", fd, 0);
    `CHECKI("nothing to read, so no item is matched", (code <= 0), 1);
    if ($abstime > 0.0) begin
      good_fd = $fopen("ch09_047_fscanf.dat", "r");
      good_code = $fscanf(good_fd, "%d", good_value);
      $fclose(good_fd);
      `CHECKI("§9.5.4.2 one %d matched and assigned, so code is 1", good_code, 1);
      `CHECKI("§9.5.4.2 and the assigned item is the 42 in the file", good_value, 42);
    end
    I(p,n) <+ V(p,n) + code + value + good_code + good_value;
  end
endmodule
