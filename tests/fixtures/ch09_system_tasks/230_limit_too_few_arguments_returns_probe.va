// §9.17.3: "In all cases, the simulator is responsible for determining if
// limiting should be applied and what the return value is on a given iteration.
// In particular, the simulator may simply choose to have $limit() return the
// value of its first argument". `steplim` is a name VerA implements with one
// argument (the step); called without it, the site is declined. (pnjlim and
// fetlim, whose arity §9.17.3 fixes, are refused as E0809 instead.) VerA
// declines this site: it compiles, warns W0853 (too few arguments for the
// algorithm), and returns the probe unchanged. The warning is asserted by the
// unit test "a declined $limit is W0853 naming why"
// (lib/backend/codegen/test.zig); the analog harness has no warning directive,
// so this file asserts what the clause fixes about the value.
//
// Two 100 ohm resistors divide V(p) = 1 V, so V(a) = 0.5 V, independent of any
// limiting; the returned value is used in the contribution, so a return other
// than the probe would move the root.
//
//! lrm 9.17.3
//! solve
//! bias V(p) = 1, V(n) = 0
`include "check.vh"
module ch09_limit_too_few_arguments_returns_probe(p, n);
  inout p, n; electrical p, n, a;
  real v;
  analog begin
    v = $limit(V(a,n), "steplim");
    I(p,a) <+ V(p,a) / 100.0;
    I(a,n) <+ v / 100.0;
    `CHECKR("a steplim with no step returns the probe", v, 0.5, 1e-3);
  end
endmodule
