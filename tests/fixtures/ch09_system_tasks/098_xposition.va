// §9.18: "$xposition and $yposition are the offsets, in meters, of the location
// of the center of the instance." Table 9-29 gives the combining rule: the
// top-level value is 0.0 m and the resolved value is
// $xposition_specified + $xposition_hier.
//
// This module is elaborated on its own, so it IS the top of the hierarchy and
// there is no enclosing instance to add an offset from: the resolved value is
// the top-level value, 0.0 m, exactly — a sum of no terms, not a computation
// that could round, so the check is for exact equality.
`include "check.vh"
module ch09_atomic_xposition(p, n);
  inout p, n; electrical p, n;
  analog begin
    `CHECKX("Table 9-29 top-level $xposition", $xposition, 0.0);
    I(p,n) <+ V(p,n) + $xposition;
  end
endmodule
