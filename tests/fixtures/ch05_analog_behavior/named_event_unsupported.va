// §5.10.4 named events. §5.10 lists three kinds of analog event — global
// (5.10.2), monitored (5.10.3) and named (5.10.4) — so the named event is part
// of the analog language, not a digital-only construct: annex C.7's "No digital
// behavior or events are supported in Verilog-A" excludes digital events, and
// C.2 lists "a set of events to control when certain code is simulated" as a
// Verilog-A feature.
//
// Syntax 5-20 `event_declaration ::= event list_of_event_identifiers ;` and
// Syntax 5-21 `event_trigger ::= -> hierarchical_event_identifier ;`. §5.10.4:
// "Named events can be triggered from always and initial blocks, or from an
// analog event statement", and the clause's own example triggers ana_event from
// `@(timer(1n))` and detects it with `@(ana_event)` in the SAME analog block.
// That is the shape here, with initial_step (§5.10.2) in place of the timer so
// the fixture is a one-timepoint dc run and does not also depend on the
// separate timer-timing defect that event_timer.va records.
//
// Statements in an analog block execute in order at each timepoint, so the
// trigger on the line above has occurred by the time the detection statement
// runs, and `seen` is 1.0. §3.2 starts it at 0.0, so a compiler that accepted
// `@(tick)` as a guard that is silently never true reads 0.0 instead.
//
// A contribution may NOT appear inside an event control block (§5.10, A.6.4);
// that rule is a separate fixture, event_contribution_rejected.va.
//
//! lrm 5.10.4
`include "check.vh"
module ch5_named_event(p);
  inout p; electrical p; real seen;
  event tick;
  analog begin
    @(initial_step) -> tick;
    @(tick) seen = 1.0;
    `CHECKX("a named event triggered in the analog block is detected in it", seen, 1.0);
    I(p) <+ 1m * seen;
  end
endmodule
