// §5.8.1 conditional statements nested 500 deep: each `if` is the whole
// body of the one before it. The device writes them as 500 nested Zig
// blocks; its indentation stops growing past 32 levels
// (`lib/backend/codegen.zig` `Gen.max_indent`), so the text is linear in the
// nesting (it was quadratic: 8000 nested `?:` were 2.4 GB of device), and Zig,
// which does not read indentation, compiles it as it would the indented form.
//
// BY HAND. The bias pins V(p) = 0. Level k (k = 1 .. 500) tests 0 > -k, which
// holds, and adds 1.0, so x = 500.0 exactly. The innermost level also adds
// 0.5: x = 500.5, exact in binary.
//
//! lrm 5.8.1
//! bias V(p) = 0
//! checks 1
`include "check.vh"
module nested_ifs_500(p);
  inout p; electrical p;
  real x;
  analog begin
    x = 0.0;
if (V(p) > -1.0) begin x = x + 1.0;
if (V(p) > -2.0) begin x = x + 1.0;
