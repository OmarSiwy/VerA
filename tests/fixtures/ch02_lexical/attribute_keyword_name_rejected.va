// LRM 2.9 Syntax 2-4 and A.9.1: `attr_name ::= identifier`. A keyword is
// not an identifier (§2.8.2: keywords are "reserved identifiers"), and only
// §2.9.2's own `units`, which annex B reserves and §2.9.2 prints unescaped,
// is exempt (docs/Vague_Decisions.md VD-024). IEEE 1364-2005 A.9.1 has the
// same production.
//
// The keyword `module` is the only change from the legal neighbour
// attribute_keyword_name_escaped.va, which writes it `\module ` and also uses
// `units`.
//! lrm 2.9
//! reject E0208
//! reject found keyword `module`: an attribute name is an identifier
`include "check.vh"
module attribute_keyword_name_rejected(p, n);
    inout p, n;
    electrical p, n;
    (* module = 1, units = "S" *) parameter real g = 2.0;
    analog I(p, n) <+ g * V(p, n);
endmodule
