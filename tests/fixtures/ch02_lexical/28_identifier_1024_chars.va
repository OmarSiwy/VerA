// LRM 2.8: "Implementations may set a limit on the maximum length of
// identifiers, but the limit shall be at least 1024 characters." The real
// variable below is EXACTLY 1024 characters and is written and then read back
// through its full spelling. This checks single-name acceptance and readback,
// not prefix truncation: consistently truncated names could still pass.
// That distinctness obligation is tested by digital/audit_ams_lexical_long_distinct.v,
// whose two names differ only at character 1024.
// The MODULE name is deliberately short: the testbench generator writes one
// file per module named "<module>.device.zig", and a 1024-character module
// name overruns the 255-byte filesystem name limit (NameTooLong).
// V(p) is held at 0.25, so 3*V(p) is exactly 0.75.
//! lrm 2.8
`include "check.vh"
//! bias V(p) = 0.25
module ch02_identifier_1024_chars(p); inout p; electrical p; real ;
analog begin
   = 3.0 * V(p);
  `CHECKX("identifier_1024_chars", , 0.75);
  I(p) <+ V(p);
end endmodule
