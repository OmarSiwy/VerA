// LRM 2.9, Syntax 2-4, spells the value slot of an attribute as a CONSTANT
// expression and nothing weaker:
//
//     attribute_instance ::= (* attr_spec { , attr_spec } *)
//     attr_spec          ::= attr_name [ = constant_expression ]
//     attr_name          ::= identifier
//
// It has to be constant. 2.9 says attributes carry "properties about objects,
// statements and groups of statements in the HDL source that can be used by
// various tools" — a tool that is not a simulator, reading the source without
// solving it. `z` below is an analog block variable whose value exists only
// during a solve, so there is no value for such a tool to read, and no point in
// the elaboration at which the attribute could be said to have one.
//
// This is the value half of the rule; 30_nested_attribute_rejected.va is the
// other half of the same sentence pair ("It shall be illegal to specify the
// value of an attribute with a constant expression that contains an attribute
// instance"), and 29_attribute_default_and_multiple.va pins what a legal
// constant value does.
//
// Inert today — nothing downstream in VerA reads attribute values, so the wrong
// acceptance has no observable consequence yet. It will the moment one does.
//
// The pin was the PHASE label for as long as VerA's not-constant codes were all
// bound to other contexts (array bound, array index, genvar loop bound) and none
// of them could fire here. E0357 is the code for `attr_spec`'s own
// `constant_expression`, so the pin is now it.
//
// Still inert downstream — nothing in VerA reads attribute values — which is why
// the rule is checked and the value is then dropped.
//! lrm 2.9
//! lrm A.9.1
//! reject E0357
module ch02_attribute_value_not_constant_rejected(p, n);
    inout p, n;
    electrical p, n;
    real z;
    (* q = z *) parameter real gain = 1.0;
    analog begin
        z = 2.0;
        I(p, n) <+ gain * V(p, n);
    end
endmodule
