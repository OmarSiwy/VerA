// LRM 2.8: "Implementations may set a limit on the maximum length of
// identifiers, but the limit shall be at least 1024 characters." A module
// name is an identifier too, and the one below is EXACTLY 1024 characters.
// 28_identifier_1024_chars.va covers a variable's name; this covers the
// module's, which VerA also uses to name the files it builds the device from
// and used to overrun the 255-byte file-name limit (NameTooLong).
//
// HAND DERIVATION. V(p) is held at 0.25, so the contribution I(p) <+ V(p)
// reads back 0.25 through the module's full name.
//! lrm 2.8
//! bias V(p) = 0.25
`include "check.vh"
module (p);
  inout p; electrical p;
  analog begin
    `CHECKX("a 1024-character module name compiles and runs", V(p), 0.25);
    I(p) <+ V(p);
  end
endmodule
