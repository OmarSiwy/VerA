// Annex H "parameter": a constant characterizing an INSTANCE, specifiable each
// time the module is instantiated. So the value seen inside the analog block
// must be the instance override (2.5), not the declaration's 3.0 default, and
// the flow must follow it: 2.5 * 0.25 = 0.625.
//
//! param gain = 2.5
//! bias V(p) = 0.25
`include "check.vh"
module glossary_module_parameter(p, n);
  inout p, n; electrical p, n;
  parameter real gain = 3.0;
  analog begin
    `CHECKX("the instance override replaces the default", gain, 2.5);
    `CHECKX("flow follows the overridden parameter", gain*V(p,n), 0.625);
    I(p,n) <+ gain*V(p,n);
  end
endmodule
