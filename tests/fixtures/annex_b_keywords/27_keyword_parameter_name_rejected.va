// Annex B: "Keywords are predefined nonescaped identifiers ... Verilog-AMS
// reserves the keywords listed in Table B.1." `ground` is in Table B.1, so it
// cannot be the name of a parameter (A.2.1.1 parameter_declaration), whose production (A.9.3) bottoms out in
// `identifier`, which §2.8 defines to exclude keywords. The variable position
// is 04 and its siblings; this file pins the parameter-name position. Legal
// neighbour: the same declaration with the escaped name `\ground `, which
// 26_escaped_keyword_name_positions.va runs.
//
//! lrm B
//! lrm 2.8
//! reject E0208
//! reject found `ground`
`include "disciplines.vams"
module annex_b_kw_param(p, n);
  inout p, n; electrical p, n;
  parameter real ground = 1.0;
  analog I(p, n) <+ V(p, n);
endmodule
