suite: cmcqa
what: the CMC QA test specifications (qaSpec) and their published reference results, run through ngspice + `vera --emit-osdi`
url: https://github.com/ominux/cmcqa
commit: 44d616897ed4a2ab9dba5485e7778a9450f36cdc
license: none stated (no LICENSE file in the repository): FETCHED at test time into the cache, never committed
files: model_qa/<folder>/qaSpec and what it includes, model_qa/<folder>/parameters/*, model_qa/<folder>/reference/*.standard, the release's vacode/*.va
#
# model <name> <folder under model_qa> <Verilog-A, relative to the folder> <module> <qaSpec defines, comma-separated> [<test to skip> ...]
# Every release here with a qaSpec, references and its own Verilog-A. Not
# run: bsim3v3, bsim4 4.5.0, bsimsoi 4.0 and hicum L2 2.21/2.22 ship no
# Verilog-A (VA-Models' bsim4 is 4.8.0, its hicum2 2.4.0: hicum-qa runs that).
model r3 r3/r3_va_cmc_release1.0.0 vacode/r3_cmc.va r3_cmc spectre,ngspice
model r2 r2/r2_va_cmc_releasex.x.x/r2_va ../vacode/cmcModels.va r2_cmc spectre,ngspice
model mextram504 mextram/504.8/bjt504 ../vacode/bjt504.va bjt504va hspice
model mextram504t mextram/504.8/bjt504t ../vacode/bjt504t.va bjt504tva hspice
model mextramd504 mextram/504.8/bjtd504 ../vacode/bjtd504.va bjtd504va hspice
model mextramd504t mextram/504.8/bjtd504t ../vacode/bjtd504t.va bjtd504tva hspice
model mosvar mosvar/mosvar120 vacode/mosvar.va mosvar spectre,ngspice
