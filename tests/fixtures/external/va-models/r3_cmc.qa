// VerA's QA tests for r3_cmc 1.1.2 (VA-Models code/r3_cmc/vacode), in the
// CMC qaSpec format tools/external_analog.py reads. The shapes follow the
// r3_cmc 1.0.0 CMC tests (ominux/cmcqa model_qa/r3): weak and strong
// depletion against the control node, velocity saturation, self-heating
// through the floating thermal node `dt`, the parasitic diode and
// capacitance, and noise.

nTypeSelectionArguments     r3_cmc
pins                        n1 nc n2 dt
float                       dt
temperature                 27

test                        dcWeakDp
temperature                 -40 27 150
biases                      V(n1)=0
biasList                    V(nc)=0,-10,-20
biasSweep                   V(n2)=0,20,0.2
outputs                     I(n2) I(nc)
instanceParameters          w=10e-6 l=100e-6
modelParameters             dfinf=0.01 dp=2 sw_et=0

test                        dcStrongVsat
biases                      V(n1)=0
biasList                    V(nc)=0,-10,-20
biasSweep                   V(n2)=0,20,0.2
outputs                     I(n2)
instanceParameters          w=0.3e-6 l=3e-6
modelParameters             dfinf=0.1 dp=2 ecrit=2 ecorn=0.2 du=0.05 sw_et=0

test                        dcSelfHeating
temperature                 27 100
biases                      V(n1)=0 V(nc)=0
biasSweep                   V(n2)=0,10,0.1
outputs                     I(n2) V(dt)
instanceParameters          w=1e-6 l=10e-6
modelParameters             rsh=100 rth=1e4 cth=1e-9 tc1=1e-3 tc2=1e-6 sw_et=1

test                        acParasitics
temperature                 27 125
biases                      V(n1)=0 V(n2)=0 V(dt)=0
biasSweep                   V(nc)=-5,5,0.25
outputs                     C(nc,nc) C(n1,nc) G(n1,n1)
freq                        lin 1 1e6 1e6
instanceParameters          w=10e-6 l=100e-6 a1=500e-12 a2=500e-12 p1=120e-6 p2=120e-6
modelParameters             cja=1e-3 pa=0.8 ma=0.4 ca=1e-4 cp=1e-10 isa=1e-6 rc=10 sw_et=0

test                        noiseWeakDp
biases                      V(n1)=0 V(nc)=0 V(dt)=0
biasList                    V(n2)=1,10
outputs                     N(n2)
freq                        dec 4 1 1e9
instanceParameters          w=10e-6 l=100e-6
modelParameters             dfinf=0.01 dp=2 kfn=1e-22 afn=2 bfn=1 sw_et=0
