// VerA's QA tests for r2_cmc 1.0.1 (VA-Models code/r2_cmc/vacode), in the
// CMC qaSpec format tools/external_analog.py reads: the VA-Models example's
// poly card swept through its nonlinearity at three temperatures, and its
// thermal and flicker noise.

nTypeSelectionArguments     r2_cmc
pins                        n1 n2
temperature                 27

test                        dcPoly
temperature                 -40 27 160
biases                      V(n2)=0
biasSweep                   V(n1)=-9.9,9.9,0.2
outputs                     I(n1)
instanceParameters          w=1e-6 l=20e-6
modelParameters             level=1002 rsh=200 xl=0.2e-6 xw=-0.05e-6 p3=0.12 q3=1.6 p2=0.015 q2=3.8 tc1=1.5e-4 tc2=7e-7

test                        noisePoly
temperature                 27 160
biases                      V(n2)=0
biasList                    V(n1)=1,5
outputs                     N(n1)
freq                        dec 4 1 1e9
instanceParameters          w=1e-6 l=20e-6 isnoisy=1
modelParameters             level=1002 rsh=200 xl=0.2e-6 xw=-0.05e-6 p3=0.12 q3=1.6 p2=0.015 q2=3.8 kfn=1e-24 afn=2 bfn=1
