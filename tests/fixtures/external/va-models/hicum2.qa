// VerA's QA tests for HICUM/L2 v2.4.0 (VA-Models code/hicum2/vacode/
// hicumL2V2p4p0.va), in the CMC qaSpec format tools/external_analog.py
// reads, on the VA-Models example card. The thermal terminal `tnode` floats
// (fed 0 A; the card's self-heating is on). Forward Gummel and output
// curves into high injection and avalanche at three temperatures, the
// small-signal Y parameters over V(b), noise and a base-step transient.

nTypeSelectionArguments     hicumL2va
pins                        c b e s t
float                       t
temperature                 27

test                        dcGummel
temperature                 -25 27 125
biases                      V(e)=0 V(s)=0
biasList                    V(c)=0.5,1.5
biasSweep                   V(b)=0.3,1.05,0.02
outputs                     I(c) I(b) V(t)
modelParameters             $SRC/examples/hicum2/Modelcards/examples_va.lib

test                        dcOutput
temperature                 27 125
biases                      V(e)=0 V(s)=0
biasList                    V(b)=0.75,0.85,0.9
biasSweep                   V(c)=0,4,0.05
outputs                     I(c) I(b) V(t)
modelParameters             $SRC/examples/hicum2/Modelcards/examples_va.lib

test                        acY
temperature                 -25 27 125
biases                      V(e)=0 V(s)=0 V(c)=1.5 V(t)=0
biasSweep                   V(b)=0.6,1.0,0.02
outputs                     G(b,b) G(b,c) G(c,b) G(c,c) C(b,b) C(b,c) C(c,b) C(c,c)
freq                        lin 1 1e9 1e9
modelParameters             $SRC/examples/hicum2/Modelcards/examples_va.lib

test                        noiseIc
temperature                 27 125
biases                      V(e)=0 V(s)=0 V(c)=1.5 V(t)=0
biasList                    V(b)=0.8,0.9
outputs                     N(c)
freq                        dec 4 1 1e10
modelParameters             $SRC/examples/hicum2/Modelcards/examples_va.lib

test                        tranBase
tran                        2p 1n V(b)=pulse(0.7 0.9 0.1n 20p 20p 0.4n 1n)
biases                      V(e)=0 V(s)=0 V(c)=1.5 V(t)=0
outputs                     I(c) I(b)
modelParameters             $SRC/examples/hicum2/Modelcards/examples_va.lib
