// VerA's QA tests for bsim4 4.8.0 (VA-Models code/bsim4/vacode), in the CMC
// qaSpec format tools/external_analog.py reads, on the VA-Models example
// nmos card. Transfer and output curves cover subthreshold, linear and
// saturation (and the body effect through V(b)), the small-signal tests
// accumulation through inversion, at three temperatures; then channel
// noise and a gate-step transient.

nTypeSelectionArguments     bsim4va
pins                        d g s b
temperature                 27

test                        dcIdVg
temperature                 -40 27 125
biases                      V(s)=0 V(d)=0.05
biasList                    V(b)=0,-0.5
biasSweep                   V(g)=-0.2,1.2,0.02
outputs                     I(d) I(g) I(b)
instanceParameters          w=10e-6 l=1e-6 nf=1
modelParameters             $SRC/examples/bsim4/Modelcards/modelcard.nmos

test                        dcIdVd
temperature                 27 125
biases                      V(s)=0 V(b)=0
biasList                    V(g)=0.4,0.7,1.0,1.2
biasSweep                   V(d)=0,1.2,0.02
outputs                     I(d) I(b)
instanceParameters          w=10e-6 l=1e-6 nf=1
modelParameters             $SRC/examples/bsim4/Modelcards/modelcard.nmos

test                        acCv
temperature                 -40 27 125
biases                      V(s)=0 V(b)=0 V(d)=0
biasSweep                   V(g)=-1.2,1.2,0.05
outputs                     C(g,g) C(g,d) C(d,g) C(d,d) G(d,d)
freq                        lin 1 1e6 1e6
instanceParameters          w=10e-6 l=1e-6 nf=1
modelParameters             $SRC/examples/bsim4/Modelcards/modelcard.nmos

test                        acSat
temperature                 27 125
biases                      V(s)=0 V(b)=0 V(g)=1.0
biasSweep                   V(d)=0,1.2,0.05
outputs                     G(d,d) G(d,g) C(g,g) C(g,d)
freq                        lin 1 1e6 1e6
instanceParameters          w=10e-6 l=1e-6 nf=1
modelParameters             $SRC/examples/bsim4/Modelcards/modelcard.nmos

test                        noiseSat
temperature                 27 125
biases                      V(s)=0 V(b)=0 V(g)=1.0
biasList                    V(d)=0.05,1.2
outputs                     N(d)
freq                        dec 4 1 1e9
instanceParameters          w=10e-6 l=1e-6 nf=1
modelParameters             $SRC/examples/bsim4/Modelcards/modelcard.nmos

test                        tranGate
tran                        10p 4n V(g)=pulse(0 1.2 0.5n 0.2n 0.2n 1n 4n)
biases                      V(s)=0 V(b)=0 V(d)=1.2
outputs                     I(d) I(g)
instanceParameters          w=10e-6 l=1e-6 nf=1
modelParameters             $SRC/examples/bsim4/Modelcards/modelcard.nmos
