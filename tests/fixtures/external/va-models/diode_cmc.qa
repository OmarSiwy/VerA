// VerA's QA tests for diode_cmc 2.0.0 (VA-Models code/diode_cmc/vacode), in
// the CMC qaSpec format tools/external_analog.py reads. Each test runs on
// VerA's and on openvaf-r's library in the same ngspice; every output is
// compared with the CMC rule. Biases cover reverse, breakdown onset, the
// exponential region and high injection through the series resistance;
// three temperatures exercise the temperature scaling.

nTypeSelectionArguments     diode_cmc
pins                        a k
temperature                 27

test                        dcForward
temperature                 -25 27 125
biases                      V(k)=0
biasSweep                   V(a)=-1,1.2,0.02
outputs                     I(a)
instanceParameters          ab=100e-12 ls=40e-6 lg=10e-6
modelParameters             idsatrbot=1e-6 idsatrsti=1e-12 idsatrgat=1e-12 rsbot=10 rssti=0 rsgat=0 csrhbot=1e2 imax=1

test                        dcBreakdown
temperature                 27 125
biases                      V(k)=0
biasSweep                   V(a)=-12,0,0.1
outputs                     I(a)
instanceParameters          ab=100e-12 ls=40e-6 lg=10e-6
modelParameters             vbrbot=10 vbrsti=10 vbrgat=10 pbrbot=4 cbbtbot=1e-12 fbbtrbot=1e9 stfbbtbot=-1e-3 idsatrbot=1e-6

test                        acCap
temperature                 -25 27 125
biases                      V(k)=0
biasSweep                   V(a)=-5,0.6,0.1
outputs                     C(a,a) G(a,a)
freq                        lin 1 1e6 1e6
instanceParameters          ab=100e-12 ls=40e-6 lg=10e-6
modelParameters             cjorbot=1e-3 cjorsti=1e-9 cjorgat=1e-9 idsatrbot=1e-6 rsbot=10 tau=200n

test                        noiseForward
temperature                 27 125
biases                      V(k)=0
biasList                    V(a)=0.3,0.6
outputs                     N(a)
freq                        dec 4 1 1e9
instanceParameters          ab=100e-12 ls=40e-6 lg=10e-6
modelParameters             idsatrbot=1e-6 rsbot=10 kf=1e-12 af=1 ef=1

test                        tranRecovery
temperature                 27
tran                        1n 1u V(a)=pulse(0.8 -1 100n 1n 1n 400n 1u)
biases                      V(k)=0
outputs                     I(a)
instanceParameters          ab=100e-12
modelParameters             idsatrbot=1e-6 rsbot=10 corecovery=1 tau=200n inj1=1 inj2=10 wi=5u nqs=50e-9 depnqs=1e-9
