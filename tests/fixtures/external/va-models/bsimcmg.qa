// VerA's QA tests for bsimcmg 111.2.1 (VA-Models code/bsimcmg/vacode), in the
// CMC qaSpec format tools/external_analog.py reads, on the VA-Models example
// nmos card. The thermal terminal `t` floats (fed 0 A), as the CMC QA wires
// it. Transfer and output curves, small-signal over accumulation to
// inversion at three temperatures, then noise and a gate-step transient.

nTypeSelectionArguments     bsimcmg_va
pins                        d g s e t
float                       t
temperature                 27

test                        dcIdVg
temperature                 -40 27 125
biases                      V(s)=0 V(e)=0 V(d)=0.05
biasSweep                   V(g)=-0.2,1.0,0.02
outputs                     I(d) I(g) I(e)
instanceParameters          l=0.2e-6 nf=10
modelParameters             $SRC/examples/bsimcmg/Modelcards/modelcard.nmos

test                        dcIdVd
temperature                 27 125
biases                      V(s)=0 V(e)=0
biasList                    V(g)=0.4,0.7,1.0
biasSweep                   V(d)=0,1.0,0.02
outputs                     I(d)
instanceParameters          l=0.2e-6 nf=10
modelParameters             $SRC/examples/bsimcmg/Modelcards/modelcard.nmos

test                        acCv
temperature                 -40 27 125
biases                      V(s)=0 V(e)=0 V(d)=0 V(t)=0
biasSweep                   V(g)=-1.0,1.0,0.05
outputs                     C(g,g) C(g,d) C(d,g) C(d,d) G(d,d)
freq                        lin 1 1e6 1e6
instanceParameters          l=0.2e-6 nf=10
modelParameters             $SRC/examples/bsimcmg/Modelcards/modelcard.nmos

test                        acSat
temperature                 27 125
biases                      V(s)=0 V(e)=0 V(g)=0.8 V(t)=0
biasSweep                   V(d)=0,1.0,0.05
outputs                     G(d,d) G(d,g) C(g,g) C(g,d)
freq                        lin 1 1e6 1e6
instanceParameters          l=0.2e-6 nf=10
modelParameters             $SRC/examples/bsimcmg/Modelcards/modelcard.nmos

test                        noiseSat
temperature                 27 125
biases                      V(s)=0 V(e)=0 V(g)=0.8
biasList                    V(d)=0.05,1.0
outputs                     N(d)
freq                        dec 4 1 1e9
instanceParameters          l=0.2e-6 nf=10
modelParameters             $SRC/examples/bsimcmg/Modelcards/modelcard.nmos

test                        tranGate
tran                        5p 2n V(g)=pulse(0 1.0 0.2n 0.1n 0.1n 0.5n 2n)
biases                      V(s)=0 V(e)=0 V(d)=1.0
outputs                     I(d) I(g)
instanceParameters          l=0.2e-6 nf=10
modelParameters             $SRC/examples/bsimcmg/Modelcards/modelcard.nmos
