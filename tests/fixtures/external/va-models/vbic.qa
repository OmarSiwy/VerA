// VerA's QA tests for VBIC 1.3 4T (VA-Models code/vbic/vacode/vbic_1p3.va,
// module vbic13_4t), in the CMC qaSpec format tools/external_analog.py
// reads, on the VA-Models NPN_VBIC_VLG card. Forward Gummel and output
// curves into high injection and avalanche at three temperatures, the
// small-signal Y parameters over V(b), noise and a base-step transient.

nTypeSelectionArguments     vbic13_4t
pins                        c b e s
temperature                 27

test                        dcGummel
temperature                 -25 27 125
biases                      V(e)=0 V(s)=0
biasList                    V(c)=0.5,2
biasSweep                   V(b)=0.3,1.0,0.02
outputs                     I(c) I(b) I(s)
modelParameters             $SRC/examples/vbic/Modelcards/vbic_va.mod#NPN_VBIC_VLG

test                        dcOutput
temperature                 27 125
biases                      V(e)=0 V(s)=0
biasList                    V(b)=0.75,0.8,0.85
biasSweep                   V(c)=0,4,0.05
outputs                     I(c) I(b)
modelParameters             $SRC/examples/vbic/Modelcards/vbic_va.mod#NPN_VBIC_VLG

test                        acY
temperature                 -25 27 125
biases                      V(e)=0 V(s)=0 V(c)=2
biasSweep                   V(b)=0.6,0.95,0.02
outputs                     G(b,b) G(b,c) G(c,b) G(c,c) C(b,b) C(b,c) C(c,b) C(c,c)
freq                        lin 1 1e9 1e9
modelParameters             $SRC/examples/vbic/Modelcards/vbic_va.mod#NPN_VBIC_VLG

test                        noiseIc
temperature                 27 125
biases                      V(e)=0 V(s)=0 V(c)=2
biasList                    V(b)=0.75,0.85
outputs                     N(c)
freq                        dec 4 1 1e10
modelParameters             $SRC/examples/vbic/Modelcards/vbic_va.mod#NPN_VBIC_VLG

test                        tranBase
tran                        5p 2n V(b)=pulse(0.7 0.85 0.2n 50p 50p 0.8n 2n)
biases                      V(e)=0 V(s)=0 V(c)=2
outputs                     I(c) I(b)
modelParameters             $SRC/examples/vbic/Modelcards/vbic_va.mod#NPN_VBIC_VLG
