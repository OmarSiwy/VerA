// VerA's QA tests for psp103 103.8.2 (VA-Models code/psp103/vacode), in the
// CMC qaSpec format tools/external_analog.py reads, on the VA-Models
// psp103_nmos-2 card (CEA's 103.3 reference card). Transfer and output
// curves with the body effect and the source/drain junctions (JUNCAP200),
// small-signal over accumulation to inversion, at three temperatures; then
// noise and a gate-step transient.

nTypeSelectionArguments     PSP103VA
pins                        d g s b
temperature                 27

test                        dcIdVg
temperature                 -40 27 125
biases                      V(s)=0 V(d)=0.05
biasList                    V(b)=0,-1
biasSweep                   V(g)=-0.2,1.5,0.025
outputs                     I(d) I(g) I(b)
instanceParameters          l=0.1e-6 w=1e-6 absource=1e-12 lssource=1e-6 lgsource=1e-6 abdrain=1e-12 lsdrain=1e-6 lgdrain=1e-6
modelParameters             $SRC/examples/psp103/Modelcards/psp103_nmos-2_va.mod

test                        dcIdVd
temperature                 27 125
biases                      V(s)=0 V(b)=0
biasList                    V(g)=0.5,1.0,1.5
biasSweep                   V(d)=0,1.5,0.025
outputs                     I(d) I(b)
instanceParameters          l=0.1e-6 w=1e-6 absource=1e-12 lssource=1e-6 lgsource=1e-6 abdrain=1e-12 lsdrain=1e-6 lgdrain=1e-6
modelParameters             $SRC/examples/psp103/Modelcards/psp103_nmos-2_va.mod

test                        acCv
temperature                 -40 27 125
biases                      V(s)=0 V(b)=0 V(d)=0
biasSweep                   V(g)=-1.5,1.5,0.05
outputs                     C(g,g) C(g,d) C(d,g) C(d,d) G(d,d)
freq                        lin 1 1e6 1e6
instanceParameters          l=0.1e-6 w=1e-6 absource=1e-12 lssource=1e-6 lgsource=1e-6 abdrain=1e-12 lsdrain=1e-6 lgdrain=1e-6
modelParameters             $SRC/examples/psp103/Modelcards/psp103_nmos-2_va.mod

test                        acSat
temperature                 27 125
biases                      V(s)=0 V(b)=0 V(g)=1.0
biasSweep                   V(d)=0,1.5,0.05
outputs                     G(d,d) G(d,g) C(g,g) C(g,d)
freq                        lin 1 1e6 1e6
instanceParameters          l=0.1e-6 w=1e-6 absource=1e-12 lssource=1e-6 lgsource=1e-6 abdrain=1e-12 lsdrain=1e-6 lgdrain=1e-6
modelParameters             $SRC/examples/psp103/Modelcards/psp103_nmos-2_va.mod

test                        noiseSat
temperature                 27 125
biases                      V(s)=0 V(b)=0 V(g)=1.0
biasList                    V(d)=0.05,1.5
outputs                     N(d)
freq                        dec 4 1 1e9
instanceParameters          l=0.1e-6 w=1e-6 absource=1e-12 lssource=1e-6 lgsource=1e-6 abdrain=1e-12 lsdrain=1e-6 lgdrain=1e-6
modelParameters             $SRC/examples/psp103/Modelcards/psp103_nmos-2_va.mod

test                        tranGate
tran                        10p 4n V(g)=pulse(0 1.5 0.5n 0.2n 0.2n 1n 4n)
biases                      V(s)=0 V(b)=0 V(d)=1.5
outputs                     I(d) I(g)
instanceParameters          l=0.1e-6 w=1e-6 absource=1e-12 lssource=1e-6 lgsource=1e-6 abdrain=1e-12 lsdrain=1e-6 lgdrain=1e-6
modelParameters             $SRC/examples/psp103/Modelcards/psp103_nmos-2_va.mod
