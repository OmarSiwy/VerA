// A.1.8:
//
//     connectrules_declaration ::=
//             connectrules connectrules_identifier ;
//                 { connectrules_item }
//             endconnectrules
//     connectrules_item ::= connect_insertion | connect_resolution
//
// Both alternatives begin with the keyword `connect`. `module x;` is neither,
// so it cannot appear between `connectrules` and `endconnectrules`. The same
// block holding `connect electrical, electrical resolveto electrical;` is
// accepted (probed).
//
// VerA reports E0207 "unexpected token: found `module`"; the E0205 that
// follows is the parser recovering from it.
//
//! lrm A.1.8
//! reject E0207
`include "disciplines.vams"
module annex_a_cr_top(p, n);
  inout p, n;
  electrical p, n;
  analog I(p, n) <+ V(p, n);
endmodule

connectrules annex_a_cr;
  module x;                  // illegal: not a connect_insertion or connect_resolution
endconnectrules
