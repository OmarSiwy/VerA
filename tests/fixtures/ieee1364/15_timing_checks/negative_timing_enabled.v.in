// Conditional test input: enable the simulator's negative-timing-check
// invocation option before running. No option spelling is standardized.
// IEEE 1364-2005 15.5.2, 15.5.3, 15.8.
// The window is (102,105): reference=100, setup=-2, hold=5.
// A data event at 103 violates only the cell whose checktime condition is 1.
// Observe after all delayed events; no implementation-specific internal
// delay or epsilon is prescribed by this oracle.
`timescale 1ns/1ps
module negative_enabled_cell(input clk, input d, input enabled);
  wire delayed_clk, delayed_d;
  reg note=0;
  specify
    $setuphold(posedge clk,d,-2,5,note,,enabled,delayed_clk,delayed_d);
  endspecify
endmodule
module negative_timing_enabled;
  reg clk=0,d=0;
  negative_enabled_cell enabled(clk,d,1'b1), disabled(clk,d,1'b0);
  initial begin
    #90 $display("before=%b,%b",enabled.note,disabled.note);
    #10 clk=1; #3 d=1;
    #27 $display("after=%b,%b",enabled.note,disabled.note);
    $finish(0);
  end
endmodule
