// IEEE 1364-2005 §13.5, p. 206, file adder.vg (gate-level). The text is
// adder.v's; the library each is compiled into is what differs.
module adder;
  parameter D = 0;
  foo #(10*D+1) f1();
  foo #(10*D+2) f2();
  initial #D $display("%m %l"); // gate-level
endmodule
module foo;
  parameter D = 0;
  initial #D $display("%m %l"); // gate-level
endmodule
