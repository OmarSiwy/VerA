// Conditional test input: set global reject=20% and error=50%.
// IEEE 1364-2005 14.6.2. No option spelling is standardized.
// Delay 10 gives limits (2,5), so width 4 becomes X. The local PATHPULSE$
// override (0,0) must take precedence and let the second cell's pulse pass.
`timescale 1ns/1ns
module global_pulse_cell(input a, output y);
  assign y=a;
  specify (a=>y)=10; endspecify
endmodule
module local_pulse_cell(input a, output y);
  assign y=a;
  specify specparam PATHPULSE$=(0,0); (a=>y)=10; endspecify
endmodule
module pulse_global_percentages;
  reg a=0; wire y,z;
  global_pulse_cell global_limits(a,y);
  local_pulse_cell local_limits(a,z);
  initial begin
    #20 a=1; #4 a=0;
    #7 $display("pulse=%b,%b",y,z);
    #4 $display("done=%b,%b",y,z);
    $finish(0);
  end
endmodule
