# noise_table_input.tbl
# Example of input file format for noise_table
#
#     freq        pwr
      1.0e0    1.657580e-23
      1.0e1    3.315160e-23
      1.0e2    6.636320e-23
# a comment between two pairs: 4.6.4.3 allows one "before or after any
# frequency / power pair"
      1.0e3    1.326064e-22
      1.0e4    2.652128e-22
      1.0e5    5.304256e-22
      1.0e6    1.060851e-21
# End of example input file.
